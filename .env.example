# دیتابیس
DATABASE_URL="postgresql://virgule:virgule@localhost:5432/virgule?schema=public"
POSTGRES_USER=virgule
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=virgule

# احراز هویت
# اجباری در پروڈاکشن و حداقل ۳۲ کاراکتر — بدون آن برنامه بالا نمی‌آید.
# تولید: openssl rand -base64 48
JWT_SECRET="generate-a-strong-random-secret-min-32-chars"
SESSION_MAX_AGE=604800

# کاربر ادمین پیش‌فرض (برای seed)
ADMIN_EMAIL=info@virgule.studio
ADMIN_PASSWORD=set-a-strong-admin-password

# سایت
NEXT_PUBLIC_SITE_URL=https://virgule.studio

# Cloudinary (آپلود تصویر)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
